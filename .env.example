# Nur Namen, KEINE Werte. Echte Werte nur in Vercel (Project Settings > Environment Variables) bzw. .env.local.
# Secret = geheim halten. Config = unkritisch.

# --- Schalter ---
SHOP_AKTIV=false                 # Config, Server. Standard false. Erst true, wenn alles geprueft ist
NEXT_PUBLIC_SHOP_AKTIV=false     # Config, Client-Schalter (bestehend), gleicher Wert wie SHOP_AKTIV
SHOP_HALLOWEEN=preview           # Config: off|preview|sale

# --- Shop-Datenbank (Admin-Panel-Supabase-Projekt, NICHT das PixlDrop-Projekt) ---
SHOP_SUPABASE_URL=               # Config
SHOP_SUPABASE_ANON_KEY=          # Config (oeffentlicher anon-Key)
SHOP_API_SECRET=                 # SECRET: Geheimnis fuer shop_*-RPCs (32-128 Zeichen, in der DB nur als SHA-256)
SHOP_IP_SALT=                    # SECRET: Salz fuer IP-Hash und Formular-Token
SHOP_SITE_URL=https://pixldrop.de  # Config
SHOP_ADMIN_URL=                  # Config: Link ins Admin Panel (Bestellungen)
SHOP_ALEX_MAIL=                  # Config, optional (Standard: SMTP_USER)

# --- PayPal (Orders API v2) ---
PAYPAL_ENV=sandbox               # Config: sandbox|live
PAYPAL_CLIENT_ID=                # Config/Secret
PAYPAL_CLIENT_SECRET=            # SECRET
PAYPAL_WEBHOOK_ID=               # Config

# --- Benachrichtigung ---
TELEGRAM_BOT_TOKEN=              # SECRET (bereits vorhanden)
TELEGRAM_CHAT_ID=                # Config (bereits vorhanden)
SMTP_HOST=                       # Config (bereits vorhanden)
SMTP_PORT=                       # Config
SMTP_USER=                       # Config
SMTP_PASS=                       # SECRET

# --- Cron (Loeschkonzept) ---
CRON_SECRET=                     # SECRET: Vercel sendet es als Bearer-Token an /api/shop/cron/bereinigung
